# =============================================================================
# RO Ep4 Mobile Web Server — environment contract
# =============================================================================
# Copy to `.env` and fill in. `.env` is gitignored and MUST NEVER be committed.
#
#   cp .env.example .env
#   ./tools/gen-secrets.sh          # fills every CHANGE_ME password for you
#
# Rule (CLAUDE.md §2.1): nothing in this repo hardcodes an IP, hostname, port
# or credential. Moving to a new VPS is editing this file, nothing else.
# Every key below is documented. If you add a key, document it here too.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Deployment identity
# -----------------------------------------------------------------------------

# Compose project name. Also prefixes container and volume names.
COMPOSE_PROJECT_NAME=roep4

# Which optional services to start, comma-separated. Empty = core stack only.
#   web      -> rAthena web-server (emblems / web auth token)
#   backup   -> scheduled off-host DB backup (REQUIRED from Phase 1, CLAUDE.md §4)
#   map2     -> second map-server  (see §5 below)
#   map3     -> third  map-server
# Example: COMPOSE_PROFILES=backup,web
COMPOSE_PROFILES=

# Deploy environment name. Used in log lines and backup object prefixes.
# One of: dev | staging | prod
DEPLOY_ENV=dev


# -----------------------------------------------------------------------------
# 2. Public addressing
# -----------------------------------------------------------------------------

# The hostname players reach. In prod this is your domain (Caddy gets a cert
# for it automatically). In dev, use `localhost`.
PUBLIC_HOST=localhost

# Email Let's Encrypt uses for expiry notices. Required for real TLS.
ACME_EMAIL=CHANGE_ME@example.com

# What the char-server and map-server advertise to the game client as the
# address to connect to next. MUST be an address the *client* can reach.
#   - Phase 1 (PC client direct to VPS): your VPS public IPv4.
#   - Phase 3+ (browser via wsProxy):    same, the proxy dials it internally.
# Leave as 127.0.0.1 for a purely local dev stack.
RO_ADVERTISE_IP=127.0.0.1

# Ports Caddy publishes. Change only if something else owns 80/443 on the host.
HTTP_PORT=80
HTTPS_PORT=443

# Which host interface the raw game ports bind to.
#   127.0.0.1 -> loopback only. SAFE DEFAULT. Nothing reachable from outside.
#   0.0.0.0   -> exposed to the internet. Needed ONLY for the Phase 1 gate
#                (a real PC client connecting). Set it back afterwards —
#                CLAUDE.md §Phase 8 wants only 80/443 public.
GAME_PORTS_BIND=127.0.0.1


# -----------------------------------------------------------------------------
# 3. rAthena build
# -----------------------------------------------------------------------------

# Client packet version the binaries are compiled against.
#
# 20180307 IS NOT AN ARBITRARY CHOICE, AND CHANGING IT BREAKS THE PC CLIENT.
#
# Official clients shuffle their packet ids every release. rAthena tracks that
# in src/map/clif_shuffle.hpp, roBrowser in src/Network/PacketVersions.js, and
# the two only agree on a date that appears in BOTH tables. When they disagree
# there is no error: the server parses the id as whatever else it means and the
# client waits forever.
#
# 20180307 is the newest date they agree on. We built 20180620 first, where
# roBrowser sends 0x07E4 to enter the map and rAthena has that id bound to
# clif_parse_ItemListWindowSelected — measured, not guessed.
#
# Before changing this, run:  node tools/check-client-protocol.mjs --sweep
# and regenerate the packet table in tools/smoke-play.py to match.
PACKETVER=20180307

# Max concurrent sockets per server process. Raise before you hit the ceiling,
# not after. Each connection also costs a file descriptor.
RATHENA_MAXCONN=16384

# Pre-renewal build. Ep4 is pre-renewal — do not change this to `no`.
RATHENA_PRERE=yes


# -----------------------------------------------------------------------------
# 4. Inter-server authentication
# -----------------------------------------------------------------------------
# How char-server and map-server authenticate to login-server. This is an
# account row in the `login` table, not a DB credential. Anyone who knows it
# can register a rogue map-server. Generate a real value.

RO_INTER_USER=s1
RO_INTER_PASS=CHANGE_ME_INTER_PASS

# Server name shown in the client's server-select list.
RO_SERVER_NAME=Episode4


# -----------------------------------------------------------------------------
# 5. Server topology  (CLAUDE.md §3 — map-server is single-threaded)
# -----------------------------------------------------------------------------
# One map-server process = one CPU core, regardless of box size. You scale by
# running more of them, each owning a subset of maps. That subset is named by
# MAPn_GROUP and defined in server/map-groups/<name>.conf.
#
# On KVM2 (2 vCPU) run N=1. To add a second: put `map2` in COMPOSE_PROFILES,
# set MAP1_GROUP/MAP2_GROUP to two complementary groups, redeploy. No code
# change, no rebuild.

LOGIN_PORT=6900
CHAR_PORT=6121

MAP1_PORT=5121
MAP1_GROUP=all

# Only used when `map2` / `map3` are in COMPOSE_PROFILES.
MAP2_PORT=5122
MAP2_GROUP=all
MAP3_PORT=5123
MAP3_GROUP=all


# -----------------------------------------------------------------------------
# 6. Database
# -----------------------------------------------------------------------------

DB_HOST=db
DB_PORT=3306
DB_NAME=ragnarok
DB_LOG_NAME=ragnarok_log
DB_USER=ragnarok
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_DB_ROOT_PASSWORD

# InnoDB buffer pool. Rule of thumb: ~50-60% of RAM on a dedicated DB host,
# ~25% when the game servers share the box. KVM2 has 8GB -> 2G.
DB_INNODB_BUFFER_POOL_SIZE=2G

# Log queries slower than this many seconds. On from day one (CLAUDE.md §3)
# so we can see the DB bottleneck coming instead of discovering it live.
DB_SLOW_QUERY_TIME=1

DB_MAX_CONNECTIONS=300


# -----------------------------------------------------------------------------
# 7. WebSocket bridge  (Phase 3)
# -----------------------------------------------------------------------------
# Stateless by design (CLAUDE.md §3) — never store session state here, or it
# stops being horizontally scalable.

PROXY_PORT=5999

# Comma-separated `name:host:port` routes the browser may ask the proxy to
# dial. An allowlist, not a suggestion — without it the proxy is an open relay
# into your internal network.
PROXY_ALLOWED_TARGETS=login:login:6900,char:char:6121,map:map1:5121

# Max simultaneous browser sockets per proxy instance.
PROXY_MAX_CONNECTIONS=2000

# Trust X-Forwarded-For. Only `1` when the proxy really is behind Caddy,
# otherwise clients can spoof their own IP.
PROXY_TRUST_PROXY=1


# -----------------------------------------------------------------------------
# 8. Off-host backups  (CLAUDE.md §4 — required from Phase 1)
# -----------------------------------------------------------------------------
# The host is disposable, the player data is not. A provider suspension or a
# DMCA takedown must not lose characters. Backups must leave the VPS.
#
# Configure an rclone remote (Cloudflare R2 or Backblaze B2, both free tier)
# and put its config at infra/backup/rclone.conf — that path is gitignored.

# Cron schedule for the dump. Default: every 6 hours.
BACKUP_CRON=0 */6 * * *

# rclone destination: <remote-name>:<bucket>/<prefix>
BACKUP_REMOTE=r2:ro-backups/roep4

# Delete remote dumps older than this. rclone duration syntax.
BACKUP_RETENTION=30d

# Encrypt dumps before upload. Strongly recommended — the bucket holds
# password hashes and player data. Empty = upload unencrypted.
BACKUP_GPG_PASSPHRASE=CHANGE_ME_BACKUP_PASSPHRASE
