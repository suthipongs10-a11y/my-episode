# JobDesk — คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ห้าม commit .env.local)

# PostgreSQL — ใช้ค่าจาก Supabase (Project Settings > Database > Connection string)
# หรือ Postgres ที่รันเองก็ได้ ตัวแอปไม่สนใจว่ามาจากไหน
DATABASE_URL=postgres://user:password@localhost:5432/jobdesk

# รหัสผ่านสำหรับเข้าระบบ (มีคนใช้คนเดียว) — ตั้งให้ยาวและไม่ซ้ำกับที่อื่น
APP_PASSWORD=change-me-to-something-long

# คีย์สำหรับเซ็น cookie ที่ใช้จำการล็อกอิน — สุ่มใหม่ด้วย:  openssl rand -hex 32
SESSION_SECRET=change-me-64-hex-characters


# เฉพาะตอน dev: IP ของเครื่องเวลาจะเปิดทดสอบจากมือถือในวงเดียวกัน เช่น 192.168.1.20
# DEV_ORIGINS=

# เพดานต้นทุนต่อการปิดงาน 1 งาน (บาท) — ใช้เตือนใน Phase 4
CAC_CEILING_THB=300
