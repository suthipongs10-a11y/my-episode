# JobDesk — คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ห้าม commit .env.local)

# PostgreSQL — ใช้ค่าจาก Supabase (Project Settings > Database > Connection string)
# หรือ Postgres ที่รันเองก็ได้ ตัวแอปไม่สนใจว่ามาจากไหน
DATABASE_URL=postgres://user:password@localhost:5432/jobdesk

# รหัสผ่านสำหรับเข้าระบบ (มีคนใช้คนเดียว) — ตั้งให้ยาวและไม่ซ้ำกับที่อื่น
APP_PASSWORD=change-me-to-something-long

# คีย์สำหรับเซ็น cookie ที่ใช้จำการล็อกอิน — สุ่มใหม่ด้วย:  openssl rand -hex 32
SESSION_SECRET=change-me-64-hex-characters


# เฉพาะตอน dev: IP ของเครื่องเวลาจะเปิดทดสอบจากมือถือในวงเดียวกัน เช่น 192.168.1.20
# DEV_ORIGINS=

# เพดานต้นทุนต่อการปิดงาน 1 งาน (บาท) — ใช้เตือนใน Phase 4
CAC_CEILING_THB=300

# --- Phase 3: แจ้งเตือนต่ออายุ -------------------------------------------
# จำนวนวันก่อนหมดอายุที่จะเตือน คั่นด้วยจุลภาค
RENEWAL_REMINDER_DAYS=30,14,7,1

# กุญแจสำหรับ /api/cron/renewals — ตั้งให้ยาวและสุ่ม แล้วใส่ใน Vercel Cron ด้วย
# สร้างด้วย: openssl rand -hex 32
CRON_SECRET=

# ช่องทางแจ้งเตือน — ตั้งอันใดอันหนึ่งก็พอ ถ้าไม่ตั้งเลยระบบจะแค่บันทึกไว้เฉย ๆ
# Telegram ตั้งง่ายกว่าและใช้เวลา 10 นาที: คุยกับ @BotFather เพื่อเอา token
# แล้วทักบอทหนึ่งครั้ง เปิด https://api.telegram.org/bot<token>/getUpdates เพื่อดู chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LINE Official Account — Messaging API (LINE Notify ปิดบริการไปแล้วเมื่อ มี.ค. 2025)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
