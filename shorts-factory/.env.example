# Copy to .env (repo root) and fill in what you use.

# ElevenLabs — required for voice (tools/gen_voice.py); also powers
# sound-effect generation (tools/gen_sfx.py) and music beds (tools/gen_music.py).
ELEVENLABS_API_KEY=

# Google Gemini — image generation (tools/gen_image.py), e.g. story frames.
GEMINI_API_KEY=

# fal.ai — optional, generative video clips (tools/gen_clip.py).
FAL_KEY=

# --- self-hosted TTS (tools/gen_voice_local.py) --------------------------------
# An alternative to ELEVENLABS_API_KEY for the VOICE step only: point this at a TTS
# server you run (RunPod, vLLM, ...) and no key is billed. Defaults to the OpenAI
# /v1/audio/speech body shape; LOCAL_TTS_BODY overrides it for other servers.
# It returns no per-word timestamps — fine for the vox track, not enough on its own
# for the short-N word-synced captions. See SETUP.md.
#LOCAL_TTS_URL=https://<pod-id>-8000.proxy.runpod.net/v1/audio/speech
#LOCAL_TTS_MODEL=tts-1
#LOCAL_TTS_VOICE=default
#LOCAL_TTS_FORMAT=wav
#LOCAL_TTS_API_KEY=
#LOCAL_TTS_LANG=th
#LOCAL_TTS_BODY={"text":"{text}","speaker":"{voice}","language":"th"}
