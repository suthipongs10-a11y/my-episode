# Copy to .env (repo root) and fill in what you use.

# Google Gemini TTS — THE VOICE PATH (tools/gen_voice_gemini.py). Usage-billed and always
# up, and the only TTS provider reachable from this environment: ElevenLabs, OpenAI,
# Cartesia, Deepgram, PlayHT, fal, Replicate and MiniMax all fail at proxy CONNECT.
# Get one at aistudio.google.com. GEMINI_API_KEY below is accepted as a fallback.
GOOGLE_TTS_API_KEY=
#GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
#GEMINI_TTS_VOICE=Algieba
# Prepended to every line. Gemini INTERPRETS this rather than reading it aloud, so it is
# the only handle on pace — there is no `duration` parameter. See SETUP.md.
#GEMINI_TTS_STYLE=

# ElevenLabs — the original voice path (tools/gen_voice.py), unreachable from here; still
# powers sound-effect generation (tools/gen_sfx.py) and music beds (tools/gen_music.py).
ELEVENLABS_API_KEY=

# Google Gemini — image generation (tools/gen_image.py), e.g. story frames and covers.
# Image and TTS have SEPARATE daily quotas, so images often still work on a day TTS is spent.
GEMINI_API_KEY=

# Optional extra keys. Both gen_voice_gemini.py and gen_image.py read _2.._9 and rotate to
# the next one only when the current key is FULLY spent (not round-robin).
#
# ⚠️ READ THIS BEFORE ADDING ANY: Gemini rate limits (RPM / TPM / requests-per-day) are
# enforced PER GOOGLE CLOUD PROJECT, not per key. Ten keys minted in one project share one
# quota pool and buy you nothing — key 2 hits the same wall key 1 just hit, instantly.
# Extra keys only add throughput when each comes from a DIFFERENT project.
#
# What actually works, best first:
#   1. Enable billing on the project. The paid tier raises the daily cap by orders of
#      magnitude. For a pipeline that ships videos regularly, this is the real fix.
#   2. Separate Google Cloud projects under the same account — legitimate, genuinely
#      separate quota, one key each below.
#   3. Just wait. The daily cap resets at MIDNIGHT PACIFIC TIME, which is often only a few
#      hours away — not 24h from when you hit the wall. Check the clock before assuming.
#GEMINI_API_KEY_2=
#GEMINI_API_KEY_3=

# fal.ai — optional, generative video clips (tools/gen_clip.py).
FAL_KEY=

# --- self-hosted TTS (tools/gen_voice_local.py) --------------------------------
# An alternative to ELEVENLABS_API_KEY for the VOICE step only: point this at a TTS
# server you run (RunPod, vLLM, ...) and no key is billed. Defaults to the OpenAI
# /v1/audio/speech body shape; LOCAL_TTS_BODY overrides it for other servers.
# It returns no per-word timestamps — fine for the vox track, not enough on its own
# for the short-N word-synced captions. See SETUP.md.
#LOCAL_TTS_URL=https://<pod-id>-8000.proxy.runpod.net/v1/audio/speech
#LOCAL_TTS_MODEL=tts-1
#LOCAL_TTS_VOICE=default
#LOCAL_TTS_FORMAT=wav
#LOCAL_TTS_API_KEY=
#LOCAL_TTS_LANG=th
#LOCAL_TTS_BODY={"text":"{text}","speaker":"{voice}","language":"th"}
