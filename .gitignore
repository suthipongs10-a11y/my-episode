# ---- secrets -------------------------------------------------------------
.env
.env.*
!.env.example
# The PC client's build configuration. Holds no credential, but it does hold
# the server hostname, and CLAUDE.md §2.1 keeps that out of tracked files.
client/client.env
*.pem
*.key
secrets/
rclone.conf

# ---- game assets (Gravity copyright, huge) --------------------------------
# See CLAUDE.md §2.3 — assets live outside the repo, only the pipeline is here.
*.grf
*.gpf
*.rgz
assets/
assets-build/out/
assets-build/work/
client/assets/
data/

# ---- runtime state --------------------------------------------------------
*.log
log/
logs/
infra/data/
backups/

# ---- build output ---------------------------------------------------------
node_modules/
dist/
build/
# The staged copy of the roBrowser submodule that client/build-client.mjs
# writes the generated index.html into. Disposable; the submodule is the source.
client/.build/
*.o
*.so
*.a

# ---- editors / OS ---------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Python bytecode from tools/
__pycache__/
*.pyc
