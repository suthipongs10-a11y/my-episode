# Copy to .env and fill in what you have. Everything here is optional:
# with none of it set, the repo runs on PGlite with no external calls.

# --- Database --------------------------------------------------------------
# Unset  -> PGlite at .data/dev (no setup, no network, good for development)
# Set    -> real Postgres / Supabase
# DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# --- External APIs ---------------------------------------------------------
# All optional. Without them the audit still runs and is still worth sending:
# keywords come from the site itself, and a stage with no credentials skips
# rather than fails. What you lose is rankings and the competitor comparison.
PSI_API_KEY=
DFS_LOGIN=
DFS_PASSWORD=
# Only set this to reach a sandbox or a proxy; defaults to the real API.
# DFS_BASE_URL=https://api.dataforseo.com/v3
GOOGLE_PLACES_KEY=

# --- LLM (OpenAI-compatible) ----------------------------------------------
# Model names live here and never in code: prices and generations change often.
# `cheap` runs many times per audit (page classification, keyword ideas);
# `smart` runs once, for the narrative in M5.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_CHEAP=
LLM_MODEL_SMART=

# --- Dashboard (pnpm dash) -------------------------------------------------
# Unset + WEB_HOST=127.0.0.1 -> no login, reachable only from this machine.
# Set                        -> login required, and the only way in.
# The server REFUSES to start if WEB_HOST is not loopback and this is unset:
# every client's audit is on those pages. See docs/deploy.md.
DASHBOARD_PASSWORD=
# Keeps sessions alive across a restart. Without it they are dropped (harmless
# locally, annoying in production). Any long random string.
SESSION_SECRET=
WEB_PORT=4321
WEB_HOST=127.0.0.1
# Set to 1 when served over https, and when a proxy sits in front.
WEB_SECURE_COOKIE=
WEB_TRUST_PROXY=

# --- Crawling and cost -----------------------------------------------------
# Identify yourself honestly; site owners should be able to look you up.
HTTP_USER_AGENT=WGIAuditBot/0.1 (+https://your-domain.com/bot; audit requested by site owner)
CACHE_DIR=.cache
# Milliseconds between requests to one domain. Leave at 1000 unless you own the site.
HTTP_DELAY_MS=1000
COST_BUDGET_THB=40
COST_HARD_STOP_THB=60
# THB per USD, used to price the vendor calls. Update when it drifts.
# USD_THB=36

# LOG_LEVEL=debug
