{
  "name": "wgi-audit",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "audit": "tsx apps/worker/src/cli.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "ctx": "tsx scripts/ctx.ts",
    "cost": "tsx apps/worker/src/cost-cli.ts",
    "db:push": "tsx scripts/db-push.ts",
    "test": "vitest run --reporter=json --outputFile=.vitest.json --reporter=default; tsx scripts/record-tests.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.0",
    "cheerio": "^1.0.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.0"
  }
}
