# Secrets for seo-backlink-finder. Copy to `.env` (gitignored) and fill in.
# Load with:  set -a; source .env; set +a
# Every one of these is OPTIONAL — the tool runs without any of them, with
# reduced capability (documented in the README).

# Real Google results for `discovery.provider: serpapi`. https://serpapi.com
SERPAPI_KEY=

# Google Custom Search JSON API for `discovery.provider: google_cse`.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Domain authority 0-100. Free tier at https://www.domcop.com/openpagerank/
OPENPAGERANK_KEY=

# Only needed if assist.llm is true. Lets Claude write the drafts.
ANTHROPIC_API_KEY=
