appId: {{APP_ID}}
productName: {{PRODUCT_NAME}}

directories:
    output: dist/Desktop
    buildResources: applications/electron

files:
    - applications/electron/**/*
    - applications/shared/**/*
    - src/**/*
    - node_modules/lodash-es/**/*
    - node_modules/bson/**/*
    - node_modules/granny-ro-js/**/*
    - node_modules/rijndael-js/**/*
    - package.json

extraMetadata:
    main: applications/electron/main.js
    name: {{APP_SLUG}}
    productName: {{PRODUCT_NAME}}

asar: false

win:
    target:
        - dir
    icon: applications/electron/icon.png

linux:
    target:
        - dir
    icon: applications/electron/icon.png

mac:
    target:
        - dir
    icon: applications/electron/icon.png
