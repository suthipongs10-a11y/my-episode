# =============================================================================
# client.env — what the PC client is built with
# =============================================================================
# Copy to client/client.env (gitignored) and fill in. Read by
# client/build-client.mjs; anything already in the process environment wins, so
# CI does not need this file.
#
# This is NOT the server's .env. It lives on whichever machine builds the
# client, which is normally a Windows desktop, not the VPS. Nothing secret
# belongs here — but nothing here may be committed either, because CLAUDE.md
# §2.1 keeps hostnames out of tracked files.
# =============================================================================

# --- where players connect ---------------------------------------------------

# REQUIRED. The login-server, as players reach it.
#
# USE A HOSTNAME, NOT AN IP. This value is compiled into the shipped app. With a
# DNS name, moving VPS is a DNS change (CLAUDE.md §4, "the host is disposable").
# With an IP, it is a re-release that every player has to download.
#
# The game ports must be publicly reachable for this to work at all. Our stack
# binds them to loopback by default (GAME_PORTS_BIND in the server .env) —
# see docs/phase-3-robrowser.md before you wonder why nothing connects, and
# CLAUDE.md §3c for what publishing them costs.
RO_SERVER_ADDRESS=play.example.com
RO_SERVER_PORT=6900

# Shown on the login screen and used as the app/window name.
RO_SERVER_DISPLAY=Episode4
RO_SERVER_DESC=

# --- must match the server build ---------------------------------------------

# Must equal PACKETVER in the server .env, and 20180307 is the only sensible
# value while roBrowser is the client.
#
# Official clients shuffle their packet ids every release; roBrowser's newest
# shuffle table is 20180307. Above it the client sends 0x07E4 to enter the map
# and rAthena has that id bound to something else entirely — no error, the
# character just never appears. `node tools/check-client-protocol.mjs --sweep`
# shows which versions agree, and is the thing to run before changing this.
RO_SERVER_PACKETVER=20180307

# false while the server is built PRERE=yes.
RO_SERVER_RENEWAL=false

# Sent in the login packet. Only enforced when the server checks it.
RO_SERVER_VERSION=55

# Which codepage the client decodes game text with. It must match the region
# your GRF came from, or every non-ASCII string renders as mojibake — Thai text
# read as latin-1 turns "รหัสผ่านผิดพลาด" into "ÃËÑÊ¼èÒ¹¼Ô´¾ÅÒ´", which is what a
# Thai client with langtype 1 does. From roBrowser's
# src/Utils/CodepageManager.js:
#
#   0 = Korea (windows-949)      3 = China   (gbk)
#   1 = America (windows-1252)   4 = Taiwan  (big5)
#   2 = Japan (shift-jis)        5 = Thai    (windows-874)
RO_SERVER_LANGTYPE=1

# Which world map the WorldMap UI draws. Cosmetic; 12 is roBrowser's
# pre-renewal default.
RO_SERVER_EPISODE=12

# --- game data ---------------------------------------------------------------

# REQUIRED (this or RO_CLIENT_DATA_INI). Where the GRF archives are, on the
# machine that RUNS the client. Separated by ';' — not ':' or ',', because a
# Windows path starts with a drive letter and a colon.
#
# ABSOLUTE for your own testing:
#     C:\Games\Ep4Client2\data.grf
#
# RELATIVE for the build you hand to players. A relative path is resolved
# against the folder the app was unzipped into, so put the archive inside the
# packaged folder and the download is self-contained — it works wherever the
# player extracts it:
#     game\data.grf
#
# In Electron, roBrowser reads these off local disk with node's fs. There is no
# remote client, no CDN and no asset download: the player already has the files.
# Loose files in a data\ folder are NOT read — only what is inside the GRFs.
RO_CLIENT_GRF_LIST=C:\Games\Ep4Client2\data.grf

# Alternative: point at a DATA.INI and let it name the archives.
#RO_CLIENT_DATA_INI=C:\Games\Ep4Client2\DATA.INI

# --- identity -----------------------------------------------------------------

# Window title, installer name, app id. Defaults to RO_SERVER_DISPLAY.
RO_CLIENT_PRODUCT_NAME=Episode4 Online
#RO_CLIENT_APP_ID=com.episode4.client

# Linked from the login screen's registration button.
RO_CLIENT_REGISTRATION_WEB=

# Account ids drawn in the GM name colour. Comma-separated.
RO_CLIENT_ADMIN_LIST=

# --- optional -----------------------------------------------------------------

# Off by default, every one of them. Each turns on a UI that talks to the
# server; enabling one our rAthena build does not answer is a way to break a
# client that was working. Turn them on individually, after a character walks.
# Known values: achievements, bank, cashshop, attendance, dmgsuffix,
#               homunautofeed, mapname, roulette
RO_CLIENT_FEATURES=

# rAthena's web-server (emblems, achievement storage). Leave unset if not running it.
#RO_WEBSERVER_ADDRESS=https://web.example.com

# Skip the intro animation.
RO_CLIENT_SKIP_INTRO=false

# Log every packet to the DevTools console. Loud, and the fastest way to see
# whether a disconnect is a packetver mismatch.
RO_CLIENT_PACKET_DUMP=false
